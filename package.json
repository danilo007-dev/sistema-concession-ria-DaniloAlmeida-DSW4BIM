{
  "name": "autoviva-concessionaria",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web"
  },
  "devDependencies": {"concurrently": "9.2.1"}
}
